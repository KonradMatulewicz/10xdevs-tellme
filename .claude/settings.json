{
  "permissions": {
    "allow": [
      "Bash(npx skills *)",
      "Bash(10x list *)",
      "PowerShell(Set-Clipboard *)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(npx *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Read",
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(rm -rf *)"
    ],
    "ask": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push *)",
      "Bash(git push)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',x=>d+=x);process.stdin.on('end',()=>{try{const p=JSON.parse(d);const f=(p.tool_response||{}).filePath||p.tool_input.file_path;if(f)process.stdout.write(f+'\\n')}catch(e){}})\" | { read -r f && [ -n \"$f\" ] && npx prettier --write --ignore-unknown \"$f\"; } 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  }
}
