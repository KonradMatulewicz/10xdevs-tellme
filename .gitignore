# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
# expo-env.d.ts is committed (not gitignored) — CI's `tsc --noEmit` never runs
# an Expo CLI command that would regenerate it, and it's the only thing that
# pulls in expo/types' ambient CSS-import declarations. Content is stable;
# don't hand-edit it, but do keep it tracked.

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Wrangler local dev secrets (backend/.dev.vars)
.dev.vars
**/.dev.vars

# Wrangler build cache / temp
.wrangler/
**/.wrangler/

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Claude Code local settings
.claude/settings.local.json

# MCP server config (OAuth-backed; keep out of VCS)
.mcp.json

# Vendored starter scaffolds (research lens, not app source)
tools/
