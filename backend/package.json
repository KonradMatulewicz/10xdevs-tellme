{
  "name": "tellme-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Tellme backend API — Cloudflare Worker (TypeScript REST: auth, AI transcription relay, task CRUD)",
  "scripts": {
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail --format pretty",
    "typegen": "wrangler types",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.0",
    "@cloudflare/workers-types": "^4.20260612.1",
    "vitest": "^4.1.9",
    "wrangler": "^4.100.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@supabase/supabase-js": "^2.108.1",
    "hono": "^4.12.25"
  }
}
